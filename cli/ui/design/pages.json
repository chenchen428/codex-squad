    "html": "<main class=\"w-full max-w-[640px] min-h-screen md:min-h-[920px] paper-texture border-x border-paper-rule flex flex-col justify-between relative\">\n<!-- TOP APP BAR / BRAND HEADER -->\n<header class=\"border-b border-paper-rule px-4 sm:px-6 pt-4 pb-3 bg-surface-container-low\">\n<!-- Breadcrumb row -->\n<div class=\"flex items-center justify-between gap-2 pb-2\">\n<nav class=\"flex items-center gap-1.5 font-annotation-cue text-annotation-cue text-on-surface-variant\">\n<span class=\"hover:text-primary transition-colors cursor-pointer\">父任务</span>\n<span class=\"text-outline\">/</span>\n<span class=\"hover:text-primary transition-colors cursor-pointer truncate max-w-[130px] sm:max-w-[200px]\">修复报表筛选异常</span>\n<span class=\"text-outline\">/</span>\n<span class=\"text-primary font-bold\">用量说明</span>\n</nav>\n<span class=\"font-label-stamp text-[10px] tracking-wider px-1.5 py-0.5 rounded border border-outline-variant bg-surface-container text-on-surface-variant uppercase\">\n          READONLY\n        </span>\n</div>\n<!-- Main Headline & Subtitle -->\n<div class=\"flex items-baseline justify-between pt-1\">\n<div>\n<h1 class=\"font-headline-scene text-headline-scene font-medium text-on-surface tracking-tight\">\n            任务用量说明\n            <span class=\"text-xs font-annotation-cue text-on-surface-variant font-normal ml-2\">（只读演示）</span>\n</h1>\n<p class=\"font-caption-footnote text-caption-footnote text-on-surface-variant mt-0.5\">\n            父任务执行总消耗与具体子任务分配透视\n          </p>\n</div>\n<div class=\"hidden sm:flex items-center gap-1 text-on-surface-variant font-annotation-cue text-[11px]\">\n<span class=\"material-symbols-outlined text-[14px]\">receipt_long</span>\n<span>账本状态·终结</span>\n</div>\n</div>\n<!-- Section Navigation Anchors -->\n<nav class=\"flex items-center gap-4 mt-3 pt-2 border-t border-paper-rule text-annotation-cue\">\n<a class=\"font-annotation-cue text-annotation-cue text-on-surface-variant hover:text-on-surface pb-1 transition-colors\" href=\"#overview\">\n          任务总览\n        </a>\n<a class=\"font-annotation-cue text-annotation-cue text-on-surface-variant hover:text-on-surface pb-1 transition-colors\" href=\"#session\">\n          子任务详情\n        </a>\n<a class=\"border-b-2 border-primary text-primary font-bold font-annotation-cue text-annotation-cue pb-1\" href=\"#usage\">\n          用量说明\n        </a>\n</nav>\n</header>\n<!-- MAIN SCROLLABLE CONTENT CANVAS -->\n<div class=\"px-4 sm:px-6 py-5 flex-1 flex flex-col gap-6 custom-scroll\">\n<!-- SECTION 1: PARENT TASK OVERVIEW CARD -->\n<section class=\"bg-paper-card border border-paper-rule rounded-lg p-4 sm:p-5 relative\" id=\"usage\">\n<div class=\"flex flex-wrap items-center justify-between gap-2 pb-3 border-b border-paper-rule\">\n<div class=\"flex items-center gap-2\">\n<span class=\"font-label-stamp text-label-stamp text-on-surface-variant uppercase\">父任务</span>\n<h2 class=\"font-headline-act-mobile text-headline-act-mobile font-semibold text-on-surface\">\n              修复报表筛选异常\n            </h2>\n</div>\n<span class=\"font-label-stamp text-[11px] px-2 py-0.5 rounded bg-surface-variant text-on-surface-variant border border-paper-rule\">\n            全队累计计费\n          </span>\n</div>\n<!-- Big Highlight Metric -->\n<div class=\"pt-4 pb-3 flex items-baseline justify-between flex-wrap gap-2\">\n<div>\n<div class=\"font-annotation-cue text-[12px] text-on-surface-variant uppercase tracking-wider\">本轮总用量</div>\n<div class=\"flex items-baseline gap-1 mt-0.5\">\n<span class=\"font-display-lg-mobile text-display-lg-mobile font-bold text-on-surface tracking-tight\">68.8k</span>\n<span class=\"font-annotation-cue text-sm text-on-surface-variant\">Token</span>\n</div>\n</div>\n<div class=\"text-right\">\n<div class=\"font-annotation-cue text-[11px] text-on-surface-variant\">参与执行人数</div>\n<div class=\"font-body-sans text-sm font-semibold text-on-surface mt-0.5\">2 人（Qoder &amp; Codex）</div>\n</div>\n</div>\n<!-- Composite Horizontal Bar (Input vs Output) -->\n<div class=\"space-y-1.5 my-2\">\n<div class=\"w-full h-3 bg-surface-container rounded-sm overflow-hidden flex border border-paper-rule\">\n<!-- Cached (part of input) -->\n<div class=\"h-full bg-editorial-blue/70\" style=\"width: 68.6%;\" title=\"上下文缓存: 47.2k\"></div>\n<!-- Regular input -->\n<div class=\"h-full bg-editorial-blue\" style=\"width: 20.1%;\" title=\"常规输入: 13.8k\"></div>\n<!-- Output -->\n<div class=\"h-full bg-editorial-red\" style=\"width: 11.3%;\" title=\"全队输出: 7.8k\"></div>\n</div>\n<div class=\"flex items-center justify-between font-annotation-cue text-[11px] text-on-surface-variant\">\n<span class=\"flex items-center gap-1\">\n<span class=\"inline-block w-2 h-2 rounded-[1px] bg-editorial-blue\"></span>\n              输入：61.0k\n            </span>\n<span class=\"flex items-center gap-1\">\n<span class=\"inline-block w-2 h-2 rounded-[1px] bg-editorial-blue/60\"></span>\n              （含缓存 47.2k）\n            </span>\n<span class=\"flex items-center gap-1\">\n<span class=\"inline-block w-2 h-2 rounded-[1px] bg-editorial-red\"></span>\n              输出：7.8k\n            </span>\n</div>\n</div>\n<!-- Metric Details & Helper Note -->\n<div class=\"mt-4 pt-3 border-t border-paper-rule grid grid-cols-2 gap-3 text-xs font-body-sans\">\n<div class=\"bg-surface-container-low p-2.5 rounded border border-paper-rule\">\n<div class=\"font-annotation-cue text-[11px] text-on-surface-variant\">全队输入消耗</div>\n<div class=\"font-headline-act-mobile text-base font-semibold text-on-surface mt-0.5\">61.0k Token</div>\n<div class=\"font-annotation-cue text-[11px] text-editorial-blue mt-0.5\">其中包含上下文缓存 47.2k Token</div>\n</div>\n<div class=\"bg-surface-container-low p-2.5 rounded border border-paper-rule\">\n<div class=\"font-annotation-cue text-[11px] text-on-surface-variant\">全队输出消耗</div>\n<div class=\"font-headline-act-mobile text-base font-semibold text-on-surface mt-0.5\">7.8k Token</div>\n<div class=\"font-annotation-cue text-[11px] text-on-surface-variant mt-0.5\">代码修改与回答文本</div>\n</div>\n</div>\n<!-- Plain Language Rule Box -->\n<div class=\"mt-3 p-2.5 bg-surface-container-lowest rounded border border-outline-variant/60 flex items-start gap-2\">\n<span class=\"material-symbols-outlined text-outline mt-0.5 text-sm flex-shrink-0\">info</span>\n<p class=\"font-caption-footnote text-caption-footnote text-on-surface-variant leading-relaxed\">\n<strong class=\"font-semibold text-on-surface\">说明：</strong>缓存属于输入（即对已有代码和长上下文的复用），已包含在 61.0k 输入之内，不重复相加到总用量。\n          </p>\n</div>\n</section>\n<!-- SECTION 2: CORE FOCUS - SUBTASK TOKEN DISTRIBUTION -->\n<section class=\"space-y-3\">\n<div class=\"flex items-baseline justify-between\">\n<div>\n<h3 class=\"font-headline-scene text-lg font-semibold text-on-surface flex items-center gap-1.5\">\n<span>子任务用量分布</span>\n<span class=\"font-label-stamp text-[10px] text-primary bg-primary-container/10 px-1.5 py-0.2 rounded border border-primary-container/30\">核心分配</span>\n</h3>\n<p class=\"font-caption-footnote text-caption-footnote text-on-surface-variant\">\n              子任务是被分配的具体工作，一名成员可承担多个子任务。\n            </p>\n</div>\n<span class=\"font-annotation-cue text-[11px] text-on-surface-variant\">共 3 个子任务</span>\n</div>\n<!-- 3 Subtask Cards Stack -->\n<div class=\"space-y-2.5\">\n<!-- SUBTASK 1 -->\n<article class=\"bg-surface-container-lowest border border-paper-rule hover:border-outline-variant rounded-lg p-3.5 transition-all\">\n<div class=\"flex items-start justify-between gap-2\">\n<div class=\"space-y-1\">\n<div class=\"flex items-center gap-2\">\n<span class=\"font-annotation-cue text-[11px] text-outline font-bold\">#01</span>\n<h4 class=\"font-body-sans text-sm font-semibold text-on-surface\">修复清空后的页码</h4>\n</div>\n<div class=\"flex items-center gap-2 font-annotation-cue text-[11px] text-on-surface-variant\">\n<span>执行人：<strong class=\"font-semibold text-on-surface\">Qoder</strong></span>\n<span class=\"text-outline\">·</span>\n<span class=\"inline-flex items-center gap-1 px-1.5 py-0.2 rounded bg-secondary-container/40 text-secondary font-medium\">\n<span class=\"w-1.5 h-1.5 rounded-full bg-secondary\"></span>\n                    已完成\n                  </span>\n</div>\n</div>\n<div class=\"text-right\">\n<div class=\"font-headline-act text-base font-bold text-on-surface\">12.4k</div>\n<div class=\"font-annotation-cue text-[11px] text-on-surface-variant\">约占 18.0%</div>\n</div>\n</div>\n<!-- Single Subtask Proportion Bar -->\n<div class=\"mt-2.5 pt-2 border-t border-paper-rule\">\n<div class=\"w-full bg-surface-container h-1.5 rounded-full overflow-hidden\">\n<div class=\"bg-on-surface-variant h-full rounded-full\" style=\"width: 18.0%;\"></div>\n</div>\n</div>\n</article>\n<!-- SUBTASK 2 (Highlighted: Active and primary consumer) -->\n<article class=\"bg-paper-card border-2 border-editorial-blue/30 rounded-lg p-3.5 relative shadow-sm\">\n<div class=\"flex items-start justify-between gap-2\">\n<div class=\"space-y-1\">\n<div class=\"flex items-center gap-2\">\n<span class=\"font-annotation-cue text-[11px] text-editorial-blue font-bold\">#02</span>\n<h4 class=\"font-body-sans text-sm font-semibold text-on-surface\">保留报错前的输入</h4>\n<span class=\"font-label-stamp text-[9px] px-1 py-0.2 rounded bg-editorial-blue/10 text-editorial-blue border border-editorial-blue/20\">\n                    当前最高消耗\n                  </span>\n</div>\n<div class=\"flex items-center gap-2 font-annotation-cue text-[11px] text-on-surface-variant\">\n<span>执行人：<strong class=\"font-semibold text-on-surface\">Qoder</strong></span>\n<span class=\"text-outline\">·</span>\n<span class=\"inline-flex items-center gap-1 px-1.5 py-0.2 rounded bg-editorial-blue/10 text-editorial-blue font-medium\">\n<span class=\"w-1.5 h-1.5 rounded-full bg-editorial-blue animate-pulse\"></span>\n                    处理中\n                  </span>\n</div>\n</div>\n<div class=\"text-right\">\n<div class=\"font-headline-act text-base font-bold text-editorial-blue\">30.8k</div>\n<div class=\"font-annotation-cue text-[11px] text-on-surface-variant\">约占 44.8%</div>\n</div>\n</div>\n<!-- Proportion Bar -->\n<div class=\"mt-2.5 pt-2 border-t border-paper-rule\">\n<div class=\"w-full bg-surface-container h-2 rounded-full overflow-hidden\">\n<div class=\"bg-editorial-blue h-full rounded-full\" style=\"width: 44.8%;\"></div>\n</div>\n</div>\n<!-- Subtask direct link -->\n<div class=\"mt-2.5 flex items-center justify-end\">\n<a class=\"inline-flex items-center gap-1 font-annotation-cue text-xs text-editorial-blue hover:underline font-medium\" href=\"#session\">\n<span>查看该子任务会话详情</span>\n<span class=\"material-symbols-outlined text-xs\">arrow_forward</span>\n</a>\n</div>\n</article>\n<!-- SUBTASK 3 -->\n<article class=\"bg-surface-container-lowest border border-paper-rule hover:border-outline-variant rounded-lg p-3.5 transition-all\">\n<div class=\"flex items-start justify-between gap-2\">\n<div class=\"space-y-1\">\n<div class=\"flex items-center gap-2\">\n<span class=\"font-annotation-cue text-[11px] text-outline font-bold\">#03</span>\n<h4 class=\"font-body-sans text-sm font-semibold text-on-surface\">检查筛选和报错分支</h4>\n</div>\n<div class=\"flex items-center gap-2 font-annotation-cue text-[11px] text-on-surface-variant\">\n<span>执行人：<strong class=\"font-semibold text-on-surface\">Codex</strong></span>\n<span class=\"text-outline\">·</span>\n<span class=\"inline-flex items-center gap-1 px-1.5 py-0.2 rounded bg-tertiary-fixed-dim/30 text-tertiary font-medium\">\n<span class=\"w-1.5 h-1.5 rounded-full bg-tertiary-container\"></span>\n                    等待修改\n                  </span>\n</div>\n</div>\n<div class=\"text-right\">\n<div class=\"font-headline-act text-base font-bold text-on-surface\">25.6k</div>\n<div class=\"font-annotation-cue text-[11px] text-on-surface-variant\">约占 37.2%</div>\n</div>\n</div>\n<!-- Single Subtask Proportion Bar -->\n<div class=\"mt-2.5 pt-2 border-t border-paper-rule\">\n<div class=\"w-full bg-surface-container h-1.5 rounded-full overflow-hidden\">\n<div class=\"bg-tertiary-container h-full rounded-full\" style=\"width: 37.2%;\"></div>\n</div>\n</div>\n</article>\n</div>\n</section>\n<!-- SECTION 3: SECONDARY MODULE - MEMBER TOTALS -->\n<section class=\"bg-surface-container-low border border-paper-rule rounded-lg p-4 space-y-3\">\n<div class=\"flex items-center justify-between border-b border-paper-rule pb-2\">\n<div>\n<h4 class=\"font-body-sans text-sm font-semibold text-on-surface\">成员合计</h4>\n<p class=\"font-annotation-cue text-[11px] text-on-surface-variant\">按执行人合并统计（两位成员合计 68.8k）</p>\n</div>\n<span class=\"font-label-stamp text-[11px] text-on-surface-variant\">2 MEMBERS</span>\n</div>\n<!-- 2 Member Breakdown Cards -->\n<div class=\"grid grid-cols-1 sm:grid-cols-2 gap-2.5\">\n<!-- Member 1: Qoder -->\n<div class=\"bg-surface-container-lowest p-3 rounded border border-paper-rule flex flex-col justify-between\">\n<div class=\"flex items-start justify-between\">\n<div>\n<span class=\"font-annotation-cue text-[11px] text-outline font-bold\">执行人</span>\n<div class=\"font-body-sans font-bold text-base text-on-surface\">Qoder</div>\n</div>\n<span class=\"font-label-stamp text-[10px] px-1.5 py-0.5 rounded bg-editorial-blue/10 text-editorial-blue\">\n                2 个子任务\n              </span>\n</div>\n<div class=\"mt-2 pt-2 border-t border-paper-rule flex items-baseline justify-between\">\n<span class=\"font-annotation-cue text-[11px] text-on-surface-variant\">总计用量</span>\n<span class=\"font-headline-act text-base font-bold text-editorial-blue\">43.2k</span>\n</div>\n<p class=\"font-annotation-cue text-[10px] text-on-surface-variant mt-1\">\n              承担：子任务1 (12.4k) + 子任务2 (30.8k)\n            </p>\n</div>\n<!-- Member 2: Codex -->\n<div class=\"bg-surface-container-lowest p-3 rounded border border-paper-rule flex flex-col justify-between\">\n<div class=\"flex items-start justify-between\">\n<div>\n<span class=\"font-annotation-cue text-[11px] text-outline font-bold\">执行人</span>\n<div class=\"font-body-sans font-bold text-base text-on-surface\">Codex</div>\n</div>\n<span class=\"font-label-stamp text-[10px] px-1.5 py-0.5 rounded bg-surface-variant text-on-surface-variant\">\n                1 个子任务\n              </span>\n</div>\n<div class=\"mt-2 pt-2 border-t border-paper-rule flex items-baseline justify-between\">\n<span class=\"font-annotation-cue text-[11px] text-on-surface-variant\">总计用量</span>\n<span class=\"font-headline-act text-base font-bold text-on-surface\">25.6k</span>\n</div>\n<p class=\"font-annotation-cue text-[10px] text-on-surface-variant mt-1\">\n              承担：子任务3 (25.6k)\n            </p>\n</div>\n</div>\n<!-- Comparative Member Share Ratio Bar -->\n<div class=\"space-y-1 pt-1\">\n<div class=\"flex justify-between font-annotation-cue text-[11px] text-on-surface-variant\">\n<span>Qoder · 62.8%</span>\n<span>Codex · 37.2%</span>\n</div>\n<div class=\"w-full h-2.5 bg-surface-container rounded-sm overflow-hidden flex border border-paper-rule\">\n<div class=\"bg-editorial-blue h-full\" style=\"width: 62.8%;\" title=\"Qoder 62.8%\"></div>\n<div class=\"bg-tertiary-container h-full\" style=\"width: 37.2%;\" title=\"Codex 37.2%\"></div>\n</div>\n</div>\n</section>\n</div>\n<!-- FOOTER LINKING ACTIONS & BOTTOM BAR -->\n<footer class=\"border-t border-paper-rule px-4 sm:px-6 py-3.5 bg-surface-container-low flex flex-col sm:flex-row items-center justify-between gap-2.5\">\n<div class=\"flex items-center gap-3 w-full sm:w-auto justify-between sm:justify-start\">\n<a class=\"inline-flex items-center gap-1 font-annotation-cue text-xs text-on-surface-variant hover:text-primary transition-colors\" href=\"#overview\">\n<span class=\"material-symbols-outlined text-sm\">west</span>\n<span>返回任务与子任务总览</span>\n</a>\n</div>\n<div class=\"flex items-center gap-2 w-full sm:w-auto justify-end\">\n<a class=\"w-full sm:w-auto text-center font-label-stamp text-xs px-3 py-1.5 rounded bg-primary-container text-on-primary font-bold hover:bg-primary transit